# Base URL del cliente HTTP (src/shared/api/client.ts).
# Sin definir usa http://localhost:3000, que solo funciona con el navegador en
# la misma maquina que el backend.
# Para la demo por tunel, defini /api (ruta relativa, sin host). El cliente pide
# /api/..., Vite reenvia a localhost:3000 y el navegador nunca sale del origen
# del tunel: frontend y backend comparten origen, que es lo que necesita la
# cookie sameSite: 'lax'.
VITE_API_URL=/api
